node_modules/
dist/
*.log
.DS_Store
.env
.env.*
!.env.example
# local token cache (never commit a credential)
.token
.aether-token
# editor
.idea/
.vscode/
# scratch output (test redirects, etc.) — never a build or loop artifact
_tmp/

# agent runtime output (plans the agent writes during /plan runs)
.hermes/

# packed tarballs — `npm pack` output is a build artifact, never source.
# The release workflow packs a fresh one from the tagged commit; a committed
# copy goes stale the moment anything merges after it.
*.tgz
