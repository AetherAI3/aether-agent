{
  "name": "aether-code",
  "version": "0.1.0",
  "description": "Open-source terminal coding agent — runs on hosted frontier models (Claude, GPT, DeepSeek, Kimi, Gemma) or fully offline via Ollama. Edits your code, runs your tests, and verifies the result.",
  "type": "module",
  "bin": {
    "aether": "dist/src/main.js",
    "aether-code": "dist/src/main.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "COMMANDS.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --experimental-strip-types src/main.ts",
    "start": "node dist/src/main.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "aether",
    "coding-agent",
    "coding-assistant",
    "autonomous-agent",
    "ai-agent",
    "cli",
    "llm",
    "ai",
    "terminal",
    "agent",
    "ollama",
    "local-llm",
    "offline-ai",
    "claude",
    "gpt",
    "deepseek",
    "neo",
    "kronus"
  ],
  "license": "Apache-2.0",
  "author": "Brandon Barrante (Aether AI)",
  "homepage": "https://aethersystems.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/DBarr3/aether-code"
  },
  "bugs": {
    "url": "https://github.com/DBarr3/aether-code/issues"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
